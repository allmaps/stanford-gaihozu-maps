  "items": [
    {
      "id": "https://pages.allmaps.org/stanford-gaihozu-maps/iiif/series/tp498zb8245/manifest.json",
      "type": "Manifest",
      "label": {
        "none": [
          "佛領印度支那北部 | 四十万分一佛領印度支那北部 -- Futsuryō Indoshina hokubu | Yonjūmanbun no ichizu Futsuryō Indoshina hokubu 1:400,000, Maps Index"
        ]
      },
      "summary": {
        "none": [
          "This polygon shapefile is an index to the map series \"佛領印度支那北部 | 四十万分一佛領印度支那北部 -- Futsuryō Indoshina hokubu | Yonjūmanbun no ichizu Futsuryō Indoshina hokubu 1:400,000\" (). Stanford University Libraries holds a large collection of Japanese military and imperial maps, referred to as gaihōzu, or \"maps of outer lands.\" These maps were produced starting in the early Meiji (1868-1912) era and the end of World War II by the Land Survey Department of the General Staff Headquarters, the former Japanese Army. The Library is in the process of scanning and making available all of the maps in the collection.This layer provides an index map that can be used to locate individual scanned map sheets."
        ]
      },
