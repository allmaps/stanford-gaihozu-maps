{
  "name": "gaihozu-maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "metadata:sync": "node scripts/sync-opengeometadata.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:sample": "node scripts/build-data.mjs --series-id hx043dn1887 --limit-sheets 3",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:data": "node scripts/prepare-iiif.mjs",
    "postprocess:data": "node scripts/postprocess-data.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "enrich:data": "node scripts/enrich-data.mjs"
  },
  "dependencies": {
    "@iiif/helpers": "^4.0.0",
    "@iiif/parser": "^4.0.0",
    "@lucide/svelte": "^1.45.0",
    "@turf/helpers": "^7.4.0",
    "bits-ui": "^2.19.2",
    "fflate": "^0.8.2",
    "flatgeobuf": "^4.4.0",
    "maplibre-gl": "^6.9.0",
    "polygon-clipping": "^0.15.7",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
